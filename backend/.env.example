# Server settings
PORT=5000
# Set to your frontend origin to lock down CORS (e.g., http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Auth settings
# Change this value in your real .env file and keep it secret
JWT_SECRET=super-secret-dev-key-change-me

# SMTP settings for OTP and password-reset emails
# Gmail example: enable 2-Step Verification, then create a Google app password for Mail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmailaddress@gmail.com
# SMTP_PASS=your-gmail-app-password
# MAIL_FROM=yourgmailaddress@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmailaddress@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=yourgmailaddress@gmail.com
